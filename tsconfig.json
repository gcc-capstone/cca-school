{
  // Type-checking settings for frontend/typescript.
  // tsc only checks types (noEmit). scripts/build-ts.mjs (esbuild) produces
  // the shipped JavaScript: bundled, comment-free, whitespace-stripped and
  // with variable/function names mangled. tsc cannot mangle names itself.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true,
    "removeComments": true,
    "sourceMap": false,
    "declaration": false,
    "importHelpers": false
  },
  "include": ["frontend/typescript/**/*.ts"]
}
